{
    "name": "42lizard/catppuccin",
    "description": "The four Catppuccin flavours for the TYPO3 v14 backend",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-only",
    "keywords": ["typo3", "backend", "theme", "catppuccin"],
    "require": {
        "php": "^8.2",
        "typo3/cms-backend": "^14.3",
        "typo3/cms-core": "^14.3"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "catppuccin"
        }
    },
    "archive": {
        "exclude": ["/.ddev", "/.github", "/Development", "/Tests", "/Build", "/.gitignore", "/.editorconfig"]
    }
}
